import random
import math
import matplotlib.pyplot as plt
true_prob = [0.05, 0.08, 0.12, 0.06, 0.10]
K = 5
N = 10000
counts = [0] * K
rewards = [0] * K
total_reward = 0
regret = []
best_probability = max(true_prob)
for t in range(1, N + 1):
    if t <= K:
        ad = t - 1

    else:
        ucb = []

        for i in range(K):

            average_reward = rewards[i] / counts[i]

            exploration = math.sqrt(
                (2 * math.log(t)) / counts[i]
            )

            score = average_reward + exploration
            ucb.append(score)

        ad = ucb.index(max(ucb))
    if random.random() < true_prob[ad]:
        reward = 1
    else:
        reward = 0

    counts[ad] += 1
    rewards[ad] += reward
    total_reward += reward
    regret.append(
        t * best_probability - total_reward
    )
print("Advertisement Performance")
print("-------------------------")
for i in range(K):
    ctr = rewards[i] / counts[i]
    print("Ad", i + 1)
    print("Times Shown:", counts[i])
    print("Clicks:", rewards[i])
    print("Estimated CTR:", round(ctr, 4))
    print()
print("Total Clicks:", total_reward)
print("Cumulative Regret:", round(regret[-1], 2))
plt.plot(regret)
plt.xlabel("Number of Interactions")
plt.ylabel("Cumulative Regret")
plt.title("UCB Advertisement Selection")
plt.show()
